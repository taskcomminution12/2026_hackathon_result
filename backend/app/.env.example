# 수원대 LMS Sync — 백엔드 설정
# 이 파일을 .env 로 복사한 뒤 값 채우기. .env 는 git 에 커밋하지 말 것.
#
# Canvas 토큰은 .env 가 아니라 설정 페이지(/settings) 에서 입력 → SQLite 의
# app_setting 테이블에 저장됨. 여기엔 안 적어도 됨.

# Canvas LMS
CANVAS_BASE_URL=https://lms.suwon.ac.kr

# 다운로드 대상 폴더 (없으면 자동 생성)
# 예: C:/Users/User/OneDrive/수업자료
DOWNLOAD_ROOT=./downloads

# DB 파일 경로 (sqlite)
DATABASE_URL=sqlite:///./lms_sync.db

# 서버
HOST=127.0.0.1
PORT=8765

# 카카오 알림 (https://developers.kakao.com 에서 앱 만든 뒤 입력)
# Redirect URI 는 카카오 콘솔에 그대로 등록해야 함.
KAKAO_REST_API_KEY=709198d787b71e42258c7d9a0356f104
KAKAO_REDIRECT_URI=http://127.0.0.1:8765/api/kakao/callback

# 과제 마감 알림 — 며칠 전에 보낼지 (콤마 구분)
NOTIFY_DAYS_BEFORE=7,3,1,0
